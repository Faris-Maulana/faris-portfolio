# OpenRouter, optional for the public portfolio assistant.
# The assistant returns an explicit unavailable state when this is unset.
OPENROUTER_API_KEY=
# Optional primary model ID. Keep provider-qualified IDs current in OpenRouter.
OPENROUTER_MODEL=

# Resend, optional email notifications for contact and explicit chat follow-up.
RESEND_API_KEY=
RESEND_FROM="Portfolio <onboarding@resend.dev>"
OWNER_EMAIL=maulanafaris016@gmail.com

# Fonnte, optional second notification channel. Either provider is sufficient.
FONNTE_TOKEN=
OWNER_WA_NUMBER=

# Canonical site origin. Blank uses the production default.
# Include scheme only, without a path, query or trailing path segment.
NEXT_PUBLIC_SITE_URL=

# No application database is used. Chat keeps a capped local browser copy for
# up to 30 days and sends conversation context to OpenRouter for answers.
# Including an email in chat permits recent context to be forwarded to Faris
# through configured notification providers. Contact submissions go to those
# providers too. Never put secrets in NEXT_PUBLIC_* variables.
