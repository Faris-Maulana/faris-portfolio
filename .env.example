# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (for ARIA chat)
OPENROUTER_API_KEY=

# Resend (email notifications)
RESEND_API_KEY=

# Fonnte (WhatsApp notifications)
FONNTE_TOKEN=
OWNER_WA_NUMBER=

# GitHub (optional).
# Without it the Projects archive can only show public repositories, because
# the unauthenticated API cannot see private ones, and the rate limit is 60
# requests per hour. With it, private repos are listed too (marked Private and
# not linked, since their URLs 404 for visitors) and the limit becomes 5,000.
# A fine-grained personal access token with read-only "Metadata" permission is
# enough. Set it in the Vercel project environment, never in this repo.
GITHUB_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=
