# OpenRouter (for ARIA chat)
OPENROUTER_API_KEY=

# Resend (email notifications).
# Optional. With it (or FONNTE_TOKEN) the contact form posts to /api/contact and
# ARIA chat leads are emailed to you. Without either, the form opens the
# visitor's own mail app or WhatsApp with the message filled in, and nothing
# is stored anywhere.
# Free tier is 3,000 emails a month. No domain setup is needed to start: the
# default sender onboarding@resend.dev works immediately on a new account.
RESEND_API_KEY=
# Optional overrides.
RESEND_FROM="Portfolio <onboarding@resend.dev>"
OWNER_EMAIL=maulanafaris016@gmail.com

# Fonnte (WhatsApp notifications). Optional second channel, delivered in
# parallel with email. Either one being configured is enough.
FONNTE_TOKEN=
OWNER_WA_NUMBER=

# GitHub (optional).
# Without it the Projects archive can only show public repositories, because
# the unauthenticated API cannot see private ones, and the rate limit is 60
# requests per hour. With it, private repos are listed too (marked Private and
# not linked, since their URLs 404 for visitors) and the limit becomes 5,000.
# A fine-grained personal access token with read-only "Metadata" permission is
# enough. Set it in the Vercel project environment, never in this repo.
GITHUB_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=
